# ===== PostgreSQL (Docker) =====
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database_name

# ===== pgAdmin (Docker) =====
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# ===== Database connection =====
# Hostname "db" is used when the app runs inside Docker Compose network.
# Use "localhost" when running the backend directly on your machine.
DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/your_database_name

# ===== Auth / JWT =====
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=put_your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
